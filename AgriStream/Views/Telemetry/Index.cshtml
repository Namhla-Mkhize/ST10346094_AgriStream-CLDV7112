@{
    ViewData["Title"] = "Telemetry Simulator";
}

<h2>Telemetry Simulator</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<p>Generates fake soil sensor readings and writes them to Azure Table Storage.</p>

<form asp-action="Simulate" method="post" class="mb-3">
    <div class="mb-3">
        <label class="form-label">Number of readings (1-100)</label>
        <input type="number" name="count" value="20" class="form-control" style="max-width:200px" />
    </div>
    <button type="submit" class="btn btn-success">Generate readings</button>
</form>